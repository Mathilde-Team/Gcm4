# SPDX-License-Identifier: GPL-3.0-or-later
# Connexion ssh avec saisie automatique du mot de passe (#396).
#
# Lancé par plugins/ssh/gtk4.py dans le terminal VTE :
#   expect -f ssh.expect <ssh> [arguments ssh] <hôte>
# Le mot de passe arrive sur le descripteur 3 (tube fermé par gcm4 aussitôt
# écrit) : il ne figure ni dans la ligne de commande, ni dans
# l'environnement, ni à l'écran.
#
# Reprend la branche ssh de ssh.expect (GTK3) : « assword: » reçoit le mot
# de passe, puis la main passe à l'utilisateur. Différences voulues :
# - la sortie du serveur reste visible pendant la connexion (log_user 1) ;
# - la question de l'empreinte d'un hôte inconnu (« yes/no ») n'est plus
#   répondue « yes » automatiquement : la réponse de l'utilisateur est
#   transmise telle quelle ;
# - une demande de phrase de passe de clé, ou l'absence d'invite de mot de
#   passe au bout de 20 s comme telnet.expect (clé acceptée, agent…), rend
#   la main à l'utilisateur, au lieu d'attendre indéfiniment.

log_user 1

set canal [open /dev/fd/3 r]
gets $canal pass
close $canal

# Taille de fenêtre transmise à ssh, au plus une fois toutes les 200 ms
# (correctif #87 de ssh.expect GTK3 : certains équipements réseau se figent
# sous un flot de changements de taille).
set winch_pending 0
proc do_winch {} {
    global winch_pending spawn_out
    set winch_pending 0
    set rows [stty rows]
    set cols [stty columns]
    stty rows $rows columns $cols < $spawn_out(slave,name)
}
trap {
    global winch_pending
    if {!$winch_pending} {
        set winch_pending 1
        after 200 do_winch
    }
} WINCH

set timeout 20
spawn -noecho {*}$argv

expect {
    -re {\(yes/no[^)]*\)\?} {
        # Pas d'écho local : ssh renvoie lui-même la réponse saisie.
        stty -echo
        expect_user -re "(.*)\n"
        stty echo
        send -- "$expect_out(1,string)\r"
        exp_continue
    }
    -re "assphrase" { interact }
    "assword:" { send -- "$pass\r"; exec kill -WINCH [pid]; interact }
    timeout { exec kill -WINCH [pid]; interact }
    eof { }
}

set ret [wait]
exit [lindex $ret 3]
