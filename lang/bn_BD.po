#: data/io.github.MathildeDec.gcm4.metainfo.xml gnome_connection_manager.py
msgid "Gnome Connection Manager"
msgstr "Gnome Connection Manager"

#: data/io.github.MathildeDec.gcm4.desktop
#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Organize your hosts and open their connections in tabs"
msgstr "আপনার হোস্টগুলো সাজান এবং তাদের সংযোগ ট্যাবে খুলুন"

#: data/io.github.MathildeDec.gcm4.desktop
msgid "connection;remote;host;session;terminal;gcm4;"
msgstr "সংযোগ;দূরবর্তী;হোস্ট;সেশন;টার্মিনাল;gcm4;"

#: data/io.github.MathildeDec.gcm4.desktop
msgid "gcm4 (debug mode)"
msgstr "gcm4 (ডিবাগ মোড)"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Connection protocols provided by plugins"
msgstr "সংযোগ প্রোটোকল এক্সটেনশন থেকে আসে"

#: data/io.github.MathildeDec.gcm4.metainfo.xml gnome_connection_manager.py
#: src/gcm4/ui/host_dialog.py
msgid "Edit Host"
msgstr "হোস্ট সম্পাদনা করুন"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Gnome Connection Manager keeps your hosts in groups and opens each connection in a tab of a single window."
msgstr "Gnome Connection Manager আপনার হোস্টগুলো গ্রুপে রাখে এবং প্রতিটি সংযোগ একটি উইন্ডোর একটি ট্যাবে খোলে।"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Groups and hosts in a searchable tree, with colors and drag and drop"
msgstr "খোঁজা যায় এমন একটি ট্রিতে গ্রুপ ও হোস্ট, রং এবং টেনে এনে ছাড়ার সুবিধাসহ"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Groups and hosts in the main window"
msgstr "প্রধান উইন্ডোতে গ্রুপ ও হোস্ট"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Host passwords stored encrypted"
msgstr "হোস্টের পাসওয়ার্ড এনক্রিপ্ট করে সংরক্ষিত"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Last release of the GTK3 application; the GTK4 base is not released yet."
msgstr "GTK3 অ্যাপ্লিকেশনের সর্বশেষ সংস্করণ; GTK4 ভিত্তি এখনও প্রকাশিত হয়নি।"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Open tabs restored at the next start"
msgstr "পরের বার চালুর সময় খোলা ট্যাবগুলো পুনরুদ্ধার"

#: data/io.github.MathildeDec.gcm4.metainfo.xml gnome_connection_manager.py
#: src/gcm4/core/menu.py src/gcm4/ui/preferences.py
msgid "Settings"
msgstr "সেটিংস"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "The base application provides no protocol by itself: connections need the corresponding plugin."
msgstr "মূল অ্যাপ্লিকেশন নিজে কোনো প্রোটোকল দেয় না: সংযোগের জন্য সংশ্লিষ্ট এক্সটেনশন প্রয়োজন।"

