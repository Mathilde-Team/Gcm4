#: src/gcm4/ui/mot_de_passe_maitre.py
msgid "New recovery code…"
msgstr "Kode pemulihan baru…"

#: src/gcm4/ui/mot_de_passe_maitre.py
msgid "Optional. Protects the key that encrypts the stored passwords: it will be asked at startup. A recovery code is shown once when it is enabled."
msgstr "Opsional. Melindungi kunci yang mengenkripsi kata sandi tersimpan: akan diminta saat memulai. Kode pemulihan ditampilkan sekali saat diaktifkan."

#
#: src/gcm4/ui/mot_de_passe_maitre.py
msgid "Passwords locked"
msgstr "Kata sandi terkunci"

#: src/gcm4/ui/mot_de_passe_maitre.py
msgid "Recovery code"
msgstr "Kode pemulihan"

#
#: src/gcm4/ui/mot_de_passe_maitre.py
msgid "Status"
msgstr "Status"

#: src/gcm4/ui/mot_de_passe_maitre.py
msgid "The current recovery code will no longer work."
msgstr "Kode pemulihan saat ini tidak akan berfungsi lagi."

#: src/gcm4/ui/mot_de_passe_maitre.py
msgid "The key that encrypts the stored passwords will be stored unprotected again, as without a master password."
msgstr "Kunci yang mengenkripsi kata sandi tersimpan akan kembali disimpan tanpa perlindungan, seperti tanpa kata sandi utama."

#: src/gcm4/ui/mot_de_passe_maitre.py
msgid "The master password will be asked at each startup to unlock the stored passwords. A recovery code will then be shown once."
msgstr "Kata sandi utama akan diminta setiap kali memulai untuk membuka kata sandi tersimpan. Lalu kode pemulihan akan ditampilkan sekali."

#: src/gcm4/ui/mot_de_passe_maitre.py
msgid "The recovery code stays valid."
msgstr "Kode pemulihan tetap berlaku."

#: src/gcm4/ui/mot_de_passe_maitre.py
msgid "The two passwords do not match."
msgstr "Kedua kata sandi tidak cocok."

#
#: src/gcm4/ui/mot_de_passe_maitre.py
msgid "Unavailable: the configuration is not loaded."
msgstr "Tidak tersedia: konfigurasi belum dimuat."

#: src/gcm4/ui/mot_de_passe_maitre.py
msgid "Unlock"
msgstr "Buka kunci"

#: src/gcm4/ui/mot_de_passe_maitre.py
msgid "Write down or print this code and keep it in a safe place: it will not be shown again. If you forget the master password, it unlocks the stored passwords, then you choose a new master password."
msgstr "Catat atau cetak kode ini dan simpan di tempat yang aman: kode ini tidak akan ditampilkan lagi. Jika Anda lupa kata sandi utama, kode ini membuka kata sandi tersimpan, lalu Anda memilih kata sandi utama baru."

