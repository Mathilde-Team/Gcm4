msgstr "Rilis terakhir aplikasi GTK3; basis GTK4 belum dirilis."

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Open tabs restored at the next start"
msgstr "Tab yang terbuka dipulihkan saat dimulai berikutnya"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
