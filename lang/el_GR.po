#: data/io.github.MathildeDec.gcm4.desktop
#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Gnome Connection Manager"
msgstr "Gnome Connection Manager"

#: data/io.github.MathildeDec.gcm4.desktop
#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Organize your hosts and open their connections in tabs"
msgstr "Οργανώστε τους κεντρικούς υπολογιστές σας και ανοίξτε τις συνδέσεις τους σε καρτέλες"

#: data/io.github.MathildeDec.gcm4.desktop
msgid "connection;remote;host;session;terminal;gcm4;"
msgstr "σύνδεση;απομακρυσμένος;κεντρικός υπολογιστής;συνεδρία;τερματικό;gcm4;"

#: data/io.github.MathildeDec.gcm4.desktop
msgid "gcm4 (debug mode)"
msgstr "gcm4 (λειτουργία αποσφαλμάτωσης)"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Connection protocols provided by plugins"
msgstr "Τα πρωτόκολλα σύνδεσης παρέχονται από επεκτάσεις"

#: data/io.github.MathildeDec.gcm4.metainfo.xml src/gcm4/ui/host_dialog.py
msgid "Edit Host"
msgstr "Επεξεργασία Κεντρικού Υπολογιστή"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Gnome Connection Manager keeps your hosts in groups and opens each connection in a tab of a single window."
msgstr "Το Gnome Connection Manager κρατά τους κεντρικούς υπολογιστές σας σε ομάδες και ανοίγει κάθε σύνδεση σε μια καρτέλα ενός μόνο παραθύρου."

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Groups and hosts in a searchable tree, with colors and drag and drop"
msgstr "Ομάδες και κεντρικοί υπολογιστές σε δέντρο με αναζήτηση, χρώματα και μεταφορά και απόθεση"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Groups and hosts in the main window"
msgstr "Ομάδες και κεντρικοί υπολογιστές στο κύριο παράθυρο"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Host passwords stored encrypted"
msgstr "Οι κωδικοί πρόσβασης των κεντρικών υπολογιστών αποθηκεύονται κρυπτογραφημένοι"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Last release of the GTK3 application; the GTK4 base is not released yet."
msgstr "Τελευταία έκδοση της εφαρμογής GTK3· η βάση GTK4 δεν έχει κυκλοφορήσει ακόμη."

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Open tabs restored at the next start"
msgstr "Οι ανοιχτές καρτέλες επαναφέρονται στην επόμενη εκκίνηση"

