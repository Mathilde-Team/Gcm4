#: gnome_connection_manager.py
msgid ""
"<i>Double-click a cell to edit it.\n"
"File format: <tt>[serial_templates]</tt> in <tt>gcm.conf</tt>\n"
"<tt>My device = 9600,n,n,8,1</tt>  (baud,flow,parity,bits,stop)</i>"
msgstr ""
"<i>संपादित करने के लिए किसी सेल पर डबल-क्लिक करें।\n"
"फ़ाइल प्रारूप: <tt>gcm.conf</tt> में <tt>[serial_templates]</tt>\n"
"<tt>My device = 9600,n,n,8,1</tt> (बॉड,फ्लो,पैरिटी,बिट्स,स्टॉप)</i>"

