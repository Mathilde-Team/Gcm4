msgid "Connection protocols provided by plugins"
msgstr "پروتکل‌های اتصال توسط افزونه‌ها فراهم می‌شوند"

#: data/io.github.MathildeDec.gcm4.metainfo.xml src/gcm4/ui/host_dialog.py
msgid "Edit Host"
msgstr "ویرایش میزبان"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Gnome Connection Manager keeps your hosts in groups and opens each connection in a tab of a single window."
msgstr "Gnome Connection Manager میزبان‌های شما را در گروه‌ها نگه می‌دارد و هر اتصال را در یک زبانه از یک پنجرهٔ واحد باز می‌کند."

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Groups and hosts in a searchable tree, with colors and drag and drop"
msgstr "گروه‌ها و میزبان‌ها در درختی قابل جست‌وجو، با رنگ‌ها و کشیدن و رها کردن"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Groups and hosts in the main window"
msgstr "گروه‌ها و میزبان‌ها در پنجرهٔ اصلی"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Host passwords stored encrypted"
msgstr "گذرواژه‌های میزبان‌ها به‌صورت رمزنگاری‌شده ذخیره می‌شوند"

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Last release of the GTK3 application; the GTK4 base is not released yet."
msgstr "آخرین انتشار برنامهٔ GTK3؛ پایهٔ GTK4 هنوز منتشر نشده است."

#: data/io.github.MathildeDec.gcm4.metainfo.xml
msgid "Open tabs restored at the next start"
msgstr "بازیابی زبانه‌های باز در راه‌اندازی بعدی"

#: data/io.github.MathildeDec.gcm4.metainfo.xml src/gcm4/core/menu.py
